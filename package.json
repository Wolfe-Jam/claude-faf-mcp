{
  "name": "claude-faf-mcp",
  "version": "5.22.1",
  "mcpName": "one.faf/claude-faf-mcp",
  "description": "Persistent project context for Claude. IANA-registered .faf format. Core 14 MCP tools (30 with FAF_TOOLS=all).",
  "icon": "./assets/icons/faf-icon-256.png",
  "logo": "./assets/icons/faf-icon-256.png",
  "displayName": ".faf 🐘",
  "main": "dist/src/server.js",
  "bin": {
    "claude-faf-mcp": "dist/src/index.js"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "dev": "bun src/index.ts",
    "test": "node scripts/hermetic-test.mjs bun test --isolate --timeout=120000 --path-ignore-patterns=\"**/performance.test.ts\"",
    "test:performance": "node scripts/hermetic-test.mjs bun test tests/performance.test.ts",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 272",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "check:engines": "node scripts/check-engines.mjs",
    "prepare": "npm run build",
    "sync-version": "node scripts/sync-version.js",
    "version": "npm run sync-version && git add project.faf manifest.json agent.fafa .well-known/mcp/server-card.json server.json README.md public/index.html package.json glama.json smithery.yaml scripts/postinstall.js CONTRIBUTING.md",
    "prepublishOnly": "npm run build && npm test && npm run check:engines",
    "postinstall": "node scripts/postinstall.js",
    "debug": "bun --inspect-brk=127.0.0.1:9229 src/index.ts",
    "pack:mcpb": "npm run build && rm -rf .mcpb-staging && mkdir .mcpb-staging && cp -R dist manifest.json package.json package-lock.json PRIVACY.md README.md LICENSE CHANGELOG.md .mcpb-staging/ && find .mcpb-staging/dist -name '*.map' -delete && mkdir .mcpb-staging/assets && cp -R assets/icons .mcpb-staging/assets/ && cd .mcpb-staging && npm ci --omit=dev --ignore-scripts --no-audit --no-fund && mcpb pack . ../claude-faf-mcp-$(node -p \"require('./package.json').version\").mcpb && cd .. && rm -rf .mcpb-staging",
    "verify:mcpb": "node scripts/verify-mcpb.mjs",
    "gen:server-card": "node scripts/gen-server-card.js",
    "verify:fafa": "node scripts/verify-fafa.js"
  },
  "keywords": [
    "claude",
    "anthropic",
    "mcp",
    "model-context-protocol",
    "claude-desktop",
    "mcp-server",
    "claude-mcp",
    "faf",
    ".faf",
    "dot-faf",
    "faf-innit",
    "fast-af",
    "wolfejam",
    "project-dna",
    "ai-context",
    "ai-readiness",
    "ai-commit",
    "context-management",
    "context-mirroring",
    "context-on-demand",
    "c-mirror",
    "ai-tools",
    "llm-tools",
    "claude-tools",
    "developer-tools",
    "devtools",
    "project-intelligence",
    "context-optimization",
    "zero-config",
    "zero-setup",
    "championship",
    "championship-scoring",
    "orange-smiley",
    "podium-system",
    "gold-standard",
    "production-ready",
    "typescript",
    "typescript-strict",
    "type-safe",
    "strict-mode",
    "claude-md",
    "project-context",
    "codebase-understanding",
    "ai-assistant",
    "code-intelligence",
    "gemini",
    "cursor",
    "codex",
    "windsurf",
    "warp",
    "free-forever",
    "open-source",
    "mit-license",
    "persistent",
    "persistent-project-context"
  ],
  "author": {
    "name": "wolfejam",
    "email": "team@faf.one",
    "url": "https://wolfejam.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wolfe-Jam/claude-faf-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Wolfe-Jam/claude-faf-mcp/issues"
  },
  "homepage": "https://faf.one",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist/**",
    "!dist/**/*.map",
    "assets/icons/**",
    "scripts/postinstall.js",
    "project.faf",
    "README.md",
    "CLAUDE.md",
    "PRIVACY.md",
    "manifest.json",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "faf-cli": "^7.13.0",
    "yaml": "^2.4.1"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "@hono/node-server": ">=2.0.5",
    "hono": ">=4.13.5",
    "fast-uri": ">=4.1.2",
    "ip-address": ">=10.3.1",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "tmp": ">=0.2.6"
  }
}
